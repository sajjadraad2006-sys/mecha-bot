# ==============================================================================
# Mecha Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in required values for local development.
# NEVER commit real tokens or credentials into version control.

# Application Environment
NODE_ENV=development
LOG_LEVEL=info

# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=<your-dev-bot-token>

# Local SQLite Database Path
DATABASE_PATH=./data/mecha_bot.sqlite

# University & Timezone Configuration
DEFAULT_TIMEZONE=Asia/Baghdad

# Zero-Cost Policy Safeguards (MUST remain false)
ALLOW_PAID_AI=false
ALLOW_PAID_STORAGE=false
ALLOW_BILLING_FALLBACK=false

# AI Provider Selection: 'gemini' | 'groq' | 'openrouter' | 'workers-ai'
AI_PROVIDER=gemini

# Google Gemini API (Free Tier from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq API (Free Tier from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter API (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Cloudflare Workers AI (https://dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Telegram Mini App (Web App) URL (e.g. http://localhost:5173 or https://mecha-bot.pages.dev)
MINI_APP_URL=http://localhost:5173
