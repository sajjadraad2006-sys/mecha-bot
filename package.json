{
  "name": "mecha-bot-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mecha Bot - Academic Assistant for Mechatronics Engineering Department, University of Basrah",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:seed:test": "tsx scripts/seed-test.ts",
    "curriculum:import": "tsx scripts/import-curriculum.ts",
    "db:compat:d1": "tsx scripts/d1-compat.ts",
    "bot:dev": "tsx apps/bot/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^3.0.7",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "grammy": "^1.35.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0",
    "zod": "3.23.8"
  },
  "packageManager": "pnpm@12.4.1"
}
